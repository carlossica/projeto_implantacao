{
  "name": "simulador-clover",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicação web de estimativa de horas para projetos de implantação Clover CRM (substitui a planilha Simulador Clover).",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "db:check": "npm run db:check --workspace server",
    "db:migrate-all": "npm run db:migrate-all --workspace server",
    "catalogo:importar": "npm run catalogo:importar --workspace server --",
    "usuario:criar": "npm run usuario:criar --workspace server --"
  }
}
