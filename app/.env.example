# Copie pra .env e preencha com os valores reais.
# .env é gitignored — credenciais NUNCA vão pro repositório.

# Postgres do Simulador Clover
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Porta do servidor HTTP da API
PORT=3010

# Secret pra assinar JWTs de sessão. EM PROD precisa ser um valor forte e único.
SESSION_SECRET=dev-only-change-in-prod

# Caminho do .xlsx fonte pro importador de catálogo (npm run catalogo:importar).
PLANILHA_PATH=../Simulador Clover MÁQUINAS - Por funcionalidade - v11052026.1 (1).xlsx
